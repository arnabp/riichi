# Riichi City account credentials (dedicated bot account, not your personal one)
RIICHI_EMAIL=your@email.com
RIICHI_PASSWORD=yourpassword
# Set to "true" if RIICHI_PASSWORD is already an MD5 hash
RIICHI_PASSWORD_IS_MD5=false

# 6-char hex suffix appended to your email during login.
# Find it by running tcpdump while logging in with the game client:
#   sudo tcpdump -i <iface> -A -s 0 'host 13.112.183.79' | grep emailLogin -A1
# Look for the email field in the request body — the suffix is what follows your domain.
RIICHI_EMAIL_SUFFIX=xxxxxx

# 32-char hex device identifier. Use any consistent value (e.g. generate with:
#   node -e "require('crypto').randomBytes(16).toString('hex')" | tr -d '\n'
# If you captured it from tcpdump, use that value for consistency.
RIICHI_DEVICE_ID=00000000000000000000000000000000

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token

# Guild (server) ID to register the /season admin commands in. Guild commands
# appear instantly; leave unset to register globally (takes up to an hour).
DISCORD_GUILD_ID=your_guild_id

# Comma-separated Discord user IDs allowed to run /season commands.
# If unset, anyone with the server Administrator permission can run them.
# DISCORD_ADMIN_IDS=111111111111111111,222222222222222222

# Set to "true" ONLY after enabling the "Message Content Intent" toggle in the
# Discord developer portal (Bot → Privileged Gateway Intents). Requesting it
# while the toggle is off makes the bot fail to log in.
# It is needed so that a channel backup taken before /season rollover captures
# human-written messages; without it, rollover refuses to purge a channel that
# contains any non-bot messages it could not read.
# ENABLE_MESSAGE_CONTENT=true

# How often to poll for new games (milliseconds, default 30000)
POLL_INTERVAL_MS=30000

# League scoring, used to show the points each game was worth in the result
# embed. The game log only returns raw table scores, so points are recomputed
# from these. The defaults below are the current (Season 2) league settings;
# only change them if the league's settings change (scoring.test.ts will fail if
# they drift).
#   points = (finalScore - LEAGUE_RETURN_POINTS)/1000 + uma[rank] + oka(1st only)
# LEAGUE_OKA is the 20 a 30000 return collects from a 25000 start, paid back to
# first place. Season 2 does not pay it, which is why the default is 0 and a
# table sums to -20 rather than balancing. Setting it to 20 restores a zero-sum
# table. Try alternatives with `/season whatif` before changing anything here.
# LEAGUE_RETURN_POINTS=30000
# LEAGUE_UMA=15,5,-5,-15
# LEAGUE_OKA=0

# Override the game server URL (optional — bot auto-selects fastest server if unset)
# RIICHI_BASE_URL=http://13.112.183.79

# Tournament 1 — add more blocks (TOURNAMENT_2_*, etc.) for multiple tournaments
TOURNAMENT_1_ID=your_tournament_id
TOURNAMENT_1_CHANNEL=your_discord_channel_id_for_game_results
TOURNAMENT_1_LABEL=Spring League 2026
# Optional: enables the status channel with a live leaderboard and queue/ongoing message
# TOURNAMENT_1_STATUS_CHANNEL=your_discord_channel_id_for_status
