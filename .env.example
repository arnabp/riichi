# Riichi City account credentials (dedicated bot account, not your personal one)
RIICHI_EMAIL=your@email.com
RIICHI_PASSWORD=yourpassword
# Set to "true" if RIICHI_PASSWORD is already an MD5 hash
RIICHI_PASSWORD_IS_MD5=false

# 6-char hex suffix appended to your email during login.
# Find it by running tcpdump while logging in with the game client:
#   sudo tcpdump -i <iface> -A -s 0 'host 13.112.183.79' | grep emailLogin -A1
# Look for the email field in the request body — the suffix is what follows your domain.
RIICHI_EMAIL_SUFFIX=xxxxxx

# 32-char hex device identifier. Use any consistent value (e.g. generate with:
#   node -e "require('crypto').randomBytes(16).toString('hex')" | tr -d '\n'
# If you captured it from tcpdump, use that value for consistency.
RIICHI_DEVICE_ID=00000000000000000000000000000000

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token

# Guild (server) ID to register the /season admin commands in. Guild commands
# appear instantly; leave unset to register globally (takes up to an hour).
DISCORD_GUILD_ID=your_guild_id

# Comma-separated Discord user IDs allowed to run /season commands.
# If unset, anyone with the server Administrator permission can run them.
# DISCORD_ADMIN_IDS=111111111111111111,222222222222222222

# Set to "true" ONLY after enabling the "Message Content Intent" toggle in the
# Discord developer portal (Bot → Privileged Gateway Intents). Requesting it
# while the toggle is off makes the bot fail to log in.
# It is needed so that a channel backup taken before /season rollover captures
# human-written messages; without it, rollover refuses to purge a channel that
# contains any non-bot messages it could not read.
# ENABLE_MESSAGE_CONTENT=true

# How often to poll for new games (milliseconds, default 30000)
POLL_INTERVAL_MS=30000

# ── Injustice / skill reports (InjusticeJudge) ────────────────────────────────
# Where the 📉/📈 reports are posted — the league's #general. Set it per
# tournament with TOURNAMENT_n_INJUSTICE_CHANNEL (see the tournament block at
# the bottom of this file); INJUSTICE_CHANNEL below is a shorthand that applies
# to every tournament that has no override of its own.
#
# Setting one of the two is what turns the feature on: the bot adds a 📉 and a 📈
# reaction to every game result, and clicking one posts that game's injustice or
# skill report. With neither set, no reactions are added at all.
#
# The bot needs View Channel + Send Messages + Embed Links in the REPORT
# channel, and Add Reactions (plus Manage Messages, to clear a click so the
# report can be requested again) in the RESULTS channel.
#
# Note there is no way to switch one tournament off while a global is set — give
# each tournament its own TOURNAMENT_n_INJUSTICE_CHANNEL instead.
# INJUSTICE_CHANNEL=your_discord_channel_id_for_reports

# Python interpreter that has InjusticeJudge's dependencies. The Docker image
# sets this to its own venv; only set it for a local run (see README).
# INJUSTICE_PYTHON=/opt/ij-venv/bin/python3

# Where raw game logs fetched by InjusticeJudge are cached. Defaults to
# ./data/injustice-cache; docker-compose puts it on the persistent volume.
# INJUSTICE_CACHE_DIR=/app/data/injustice-cache

# How long a single report may take before it is given up on (ms, default
# 120000). Analysis is a second or two; the budget is for the login and fetch.
# INJUSTICE_TIMEOUT_MS=120000

# Set to "True" to render tiles as Discord custom emoji instead of unicode
# (🀇). Only useful if your server has InjusticeJudge's tile emoji uploaded —
# the IDs are hardcoded to the Longhorn Riichi server, so leave this unset
# otherwise or tiles will render as raw :1m: text.
# use_discord_tile_emoji=True

# League scoring, used to show the points each game was worth in the result
# embed. The game log only returns raw table scores, so points are recomputed
# from these. The defaults below are the current (Season 2) league settings;
# only change them if the league's settings change (scoring.test.ts will fail if
# they drift).
#   points = (finalScore - LEAGUE_RETURN_POINTS)/1000 + uma[rank] + oka(1st only)
# LEAGUE_OKA is whatever the return collects, paid back to first place: a 30000
# return needs an oka of 20 to balance, a 25000 return collects nothing and
# needs none. A table must sum to zero — if it doesn't, the difference becomes a
# per-game tax on everyone. Try changes with `/season whatif` first, and prefer
# editing src/scoring.ts, which the tests pin, over overriding here.
# LEAGUE_RETURN_POINTS=25000
# LEAGUE_UMA=15,5,-5,-15
# LEAGUE_OKA=0

# Override the game server URL (optional — bot auto-selects fastest server if unset)
# RIICHI_BASE_URL=http://13.112.183.79

# Tournament 1 — add more blocks (TOURNAMENT_2_*, etc.) for multiple tournaments
TOURNAMENT_1_ID=your_tournament_id
TOURNAMENT_1_CHANNEL=your_discord_channel_id_for_game_results
TOURNAMENT_1_LABEL=Spring League 2026
# Optional: enables the status channel with a live leaderboard and queue/ongoing message
# TOURNAMENT_1_STATUS_CHANNEL=your_discord_channel_id_for_status
# Optional: enables the 📉/📈 injustice/skill reports for this tournament, and
# names the channel they go to (usually #general). Takes precedence over
# INJUSTICE_CHANNEL above.
# TOURNAMENT_1_INJUSTICE_CHANNEL=your_discord_channel_id_for_reports
